<Application x:Class="ClawTweaksSetup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Fluent dark palette. The setup remains WPF so it can stay a truly self-contained
                 single-file executable, but these surfaces mirror current WinUI 3 dark theme
                 layering: a calm base, slightly elevated cards, subtle strokes and a restrained
                 accent used only for primary/status affordances. -->
            <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
            <Color x:Key="BgColor">#FF202020</Color>
            <Color x:Key="CardColor">#FF2B2B2B</Color>
            <Color x:Key="FooterColor">#FF252525</Color>
            <Color x:Key="StrokeColor">#FF3A3A3A</Color>
            <Color x:Key="AccentColor">#FF60CDFF</Color>
            <SolidColorBrush x:Key="BgBrush"     Color="{StaticResource BgColor}" />
            <SolidColorBrush x:Key="CardBrush"   Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="FooterBrush" Color="{StaticResource FooterColor}" />
            <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="TextBrush"       Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SubtleTextBrush" Color="#FFC7C7C7" />
            <SolidColorBrush x:Key="OkBrush"       Color="#FF6CCB5F" />
            <SolidColorBrush x:Key="WarnBrush"     Color="#FFFCE100" />
            <SolidColorBrush x:Key="ErrorBrush"    Color="#FFFF99A4" />

            <!-- Inherit the current Windows UI typeface across both XAML-authored and code-built UI. -->
            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>
            <Style TargetType="{x:Type ToolTip}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>

            <!-- Big, controller-friendly focus visual: a thick accent ring around the focused button. -->
            <Style x:Key="ControllerFocusVisual">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="2" CornerRadius="6"
                                    Margin="-3" SnapsToDevicePixels="True" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary button style used across the wizard. -->
            <Style TargetType="Button" x:Key="SetupButton">
                <Setter Property="FocusVisualStyle" Value="{StaticResource ControllerFocusVisual}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="#FF3A3A3A" />
                <Setter Property="BorderBrush" Value="#FF505050" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="Margin" Value="6,0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#FF454545" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#FF454545" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.82" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Accent (primary action) button variant. -->
            <Style TargetType="Button" x:Key="SetupButtonAccent" BasedOn="{StaticResource SetupButton}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="#FF0A0C10" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- Compact controller action tile used by the footer bars. -->
            <Style TargetType="Button" x:Key="ControllerActionTile">
                <Setter Property="FocusVisualStyle" Value="{StaticResource ControllerFocusVisual}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="#FF303030" />
                <Setter Property="BorderBrush" Value="#FF4A4A4A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="9,7,13,7" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TileBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TileBorder" Property="Background" Value="#FF3A3A3A" />
                                    <Setter TargetName="TileBorder" Property="BorderBrush" Value="#FF606060" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="TileBorder" Property="BorderBrush"
                                            Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="TileBorder" Property="Background" Value="#FF262626" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>

<Window x:Class="ClawTweaksSetup.CenterMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClawTweaks Center"
        Width="1120" Height="760"
        MinWidth="880" MinHeight="620"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- header -->
            <RowDefinition Height="*" />      <!-- build list -->
            <RowDefinition Height="Auto" />   <!-- footer action bar -->
        </Grid.RowDefinitions>

        <!-- Header: 2 columns — title/subtitle left, device banner right. -->
        <StackPanel Grid.Row="0" Margin="32,24,32,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Compact identity block: current WinUI guidance keeps app identity in the title bar
                     and avoids repeating an oversized brand mark in page content. -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/branding/ctw-center-logo.png"
                           Height="56" Stretch="Uniform" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <!-- The Setup/Center tool's own version (ClawTweaksSetup.csproj <Version>) — distinct
                         from the installed ClawTweaks app version shown further down. -->
                    <TextBlock x:Name="SetupVersionLabel" FontSize="13"
                               Foreground="{StaticResource SubtleTextBrush}"
                               HorizontalAlignment="Left" Margin="4,4,0,0" />
                </StackPanel>

                <ContentControl x:Name="DeviceBanner" Grid.Column="1"
                                Margin="16,0,0,0" VerticalAlignment="Center" Focusable="False" />
            </Grid>
            <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,16,0,0" />
        </StackPanel>

        <!-- Build list / progress host -->
        <ScrollViewer x:Name="ContentScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Padding="32,16,32,20" Focusable="False">
            <StackPanel x:Name="ContentHost" Focusable="False"
                        MaxWidth="1120" HorizontalAlignment="Stretch" />
        </ScrollViewer>

        <!-- Footer: boxed controller action tiles -->
        <Border Grid.Row="2" Background="{StaticResource FooterBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <WrapPanel x:Name="ActionBar" Orientation="Horizontal"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="20,8,20,8" />
        </Border>
    </Grid>
</Window>

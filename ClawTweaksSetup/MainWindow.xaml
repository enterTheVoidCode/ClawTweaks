<Window x:Class="ClawTweaksSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClawTweaks Center"
        Width="1120" Height="760"
        MinWidth="880" MinHeight="620"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- header + stepper -->
            <RowDefinition Height="*" />      <!-- phase content -->
            <RowDefinition Height="Auto" />   <!-- footer action bar -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="36,24,36,8">
            <TextBlock Text="ClawTweaks Center"
                       FontSize="26" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock x:Name="SubtitleText"
                       Text="Guided setup"
                       FontSize="14"
                       Foreground="{StaticResource SubtleTextBrush}"
                       Margin="0,4,0,0" />
            <ItemsControl x:Name="Stepper" Margin="0,18,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,18,0,0" />
        </StackPanel>

        <!-- Phase content host -->
        <ScrollViewer x:Name="ContentScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Padding="36,20,36,24" Focusable="False">
            <ContentControl x:Name="PhaseHost" Focusable="False"
                            MaxWidth="1040" HorizontalAlignment="Stretch" />
        </ScrollViewer>

        <!-- Footer: boxed controller action tiles -->
        <Border Grid.Row="2" Background="{StaticResource FooterBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <WrapPanel x:Name="ActionBar" Orientation="Horizontal"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="20,8,20,8" />
        </Border>
    </Grid>
</Window>

<Window x:Class="ClawTweaksSetup.InstallCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClawTweaks Center"
        Width="760" Height="440"
        MinWidth="680" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="36,28,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/branding/ctw-center-logo.png"
                   Height="52" Stretch="Uniform" HorizontalAlignment="Left"
                   RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,20" />

            <TextBlock x:Name="TitleText" Text="Set up ClawTweaks Center" FontSize="26" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />
            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" FontSize="15" LineHeight="22"
                       Foreground="{StaticResource SubtleTextBrush}"
                       Margin="0,0,0,4">
                ClawTweaks Center installs itself as a regular Windows app (Program Files + Start
                Menu shortcut) before it can install or update the ClawTweaks Game Bar widget.
            </TextBlock>
            <Border x:Name="StatusPanel" Margin="0,18,0,0" Padding="12,10" CornerRadius="6"
                    Background="#1A60CDFF" BorderBrush="#5960CDFF" BorderThickness="1"
                    Visibility="Collapsed">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="14"
                           Foreground="{StaticResource AccentBrush}" />
            </Border>
        </StackPanel>

        <WrapPanel x:Name="ActionBar" Grid.Row="1" Orientation="Horizontal"
                   HorizontalAlignment="Left" Margin="-4,0,0,-4" />
    </Grid>
</Window>
